# Nafureanu — static Vite build on Hostinger (Apache / LiteSpeed)

Options -Indexes

# SPA routing: real files and directories are served as they are (assets,
# brand, work media, api/contact.php); everything else goes to index.html.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Caching: hashed assets are immutable; the HTML shell and the contact
# endpoint must always be fresh.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|webp|png|jpg|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|sitemap\.xml|robots\.txt|site\.webmanifest|contact\.php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compression for text assets when the module is available.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
